DATABASE_URL="file:./dev.db"
SESSION_SECRET="generate-a-random-64-char-hex-string"
ADMIN_EMAIL="hola@pinky.com.uy"
ADMIN_PASSWORD="change-me"

# Formulario de "Solicitar reunión" en /contacto (https://resend.com)
RESEND_API_KEY="re_xxx"
# Remitente. Requiere verificar el dominio en Resend para usar uno propio (ej. no-reply@pinky.com.uy).
# Si no se configura, se usa el dominio de pruebas de Resend (onboarding@resend.dev).
RESEND_FROM_EMAIL="Pinky Web <onboarding@resend.dev>"
# A quién le llegan las solicitudes. Si no se configura, se usa el email de Configuración del sitio.
RESEND_TO_EMAIL="hola@pinky.com.uy"

# URL pública del sitio, usada para metadata SEO (canonical, sitemap.xml, Open Graph).
# Actualizar cuando el dominio final (ej. www.pinky.com.uy) quede conectado.
NEXT_PUBLIC_SITE_URL="https://pinky-web-production.up.railway.app"
