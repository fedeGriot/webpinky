// Prisma schema — sitio Pinky + CMS de secciones y proyectos.
// SQLite no soporta enums ni listas escalares (String[]); los campos que
// necesitan una lista corta (bullets, tags, palabras rotativas) se guardan
// como texto JSON-encoded (sufijo "Json") y se parsean en la capa de datos.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model AdminUser {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String

  createdAt DateTime @default(now())
}

/// Configuración global del sitio (contacto, redes) — fila única.
model SiteSettings {
  id           String  @id @default("singleton")
  email        String
  phone1       String
  phone2       String?
  address      String
  instagramUrl String?
  linkedinUrl  String?
  youtubeUrl   String?
  twitterUrl   String?
  foundedYear  Int     @default(2010)

  updatedAt DateTime @updatedAt
}

/// Copy editable del hero de Home — fila única.
model HeroContent {
  id                String @id @default("singleton")
  titleLine1        String
  titleAccent       String
  rotatingWordsJson String
  subtitle          String
  ctaPrimaryLabel   String
  ctaSecondaryLabel String

  updatedAt DateTime @updatedAt
}

/// Textos largos de la página "Quiénes somos" — fila única.
model AboutContent {
  id                 String @id @default("singleton")
  heroTitle          String
  heroBody           String
  growthTitle        String
  growthBody         String
  serviceCentricBody String
  growthPartnerBody  String

  updatedAt DateTime @updatedAt
}

model Client {
  id      String  @id @default(cuid())
  name    String
  logoUrl String?
  order   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Service {
  id            String  @id @default(cuid())
  slug          String  @unique
  order         Int     @default(0)
  icon          String  @default("✦")
  iconUrl       String?
  iconAccentUrl String?
  title         String
  tagline       String
  description   String
  bulletsJson   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProcessStep {
  id          String @id @default(cuid())
  order       Int    @default(0)
  title       String
  description String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Value {
  id          String @id @default(cuid())
  order       Int    @default(0)
  title       String
  description String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TeamMember {
  id       String  @id @default(cuid())
  order    Int     @default(0)
  initial  String
  fullName String?
  role     String?
  photoUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Stats reutilizables, agrupados por contexto (about | services | home).
model Stat {
  id       String  @id @default(cuid())
  context  String
  order    Int     @default(0)
  value    String
  label    String
  sublabel String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id                       String  @id @default(cuid())
  slug                     String  @unique
  title                    String
  clientName               String
  industry                 String
  year                     Int
  featured                 Boolean @default(false)
  order                    Int     @default(0)
  category                 String
  heroHeadline             String
  coverImageListingUrl     String?
  coverImageHeroMobileUrl  String?
  coverImageHeroDesktopUrl String?
  coverImageCarouselUrl    String?
  videoUrl                 String?
  accentColor              String  @default("#D90B91")
  summary                  String
  /// Meta description escrita a mano (SEO). Vacío = se arma sola desde summary.
  seoDescription           String?
  resultBadge              String?
  resultLabel              String?
  challengeTitle           String
  challengeBody            String
  solutionTitle            String
  solutionBody             String
  quoteText                String?
  quoteAuthor              String?
  servicesTagsJson         String

  stats  ProjectStat[]
  pieces ProjectPiece[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProjectStat {
  id        String @id @default(cuid())
  projectId String
  order     Int    @default(0)
  value     String
  label     String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectPiece {
  id              String  @id @default(cuid())
  projectId       String
  order           Int     @default(0)
  type            String
  title           String
  subtitle        String?
  imageUrl        String?
  imageDesktopUrl String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// Guarda cada solicitud de reunión del formulario de Contacto, sin importar
// si el mail de notificación por Resend después falla o no — así ningún
// lead se pierde solo porque el envío de mail tuvo un problema puntual
// (dominio, cuota, corte de red). emailSent/emailError quedan para poder
// diagnosticar y, si hace falta, reenviar la notificación a mano.
model MeetingRequest {
  id            String   @id @default(cuid())
  name          String
  email         String
  phone         String
  company       String
  website       String?
  role          String?
  companySize   String
  mainChallenge String
  timeline      String
  budget        String
  message       String?
  emailSent     Boolean  @default(false)
  emailError    String?
  createdAt     DateTime @default(now())
}

// Landing de servicio (/servicios/<slug>), armada con la estructura que
// recomienda la consultoría SEO (Dahseo): hero, marcas, puntos de dolor,
// servicios, casos, metodología, growth partner, testimonios, FAQs y CTA.
// Un registro por landing (Marketing Digital, Ecommerce, Paid Media...), todo
// editable desde /admin/landings. Las listas van como JSON, igual que
// bulletsJson/servicesTagsJson: cada ítem es { title, body } salvo donde se
// indica. En los títulos, el texto entre *asteriscos* va en color de acento.
model Landing {
  id        String  @id @default(cuid())
  slug      String  @unique
  order     Int     @default(0)
  published Boolean @default(false)
  /// Nombre corto para links internos y el breadcrumb (ej. "Marketing digital").
  navLabel  String

  seoTitle       String
  seoDescription String

  heroEyebrow  String
  heroTitle    String
  heroBody     String
  heroCtaLabel String

  clientsTitle String
  clientsBody  String

  painTitle      String
  painIntro      String
  painPointsJson String @default("[]")

  servicesTitle String
  servicesIntro String
  /// { title, body, href? }: href es un link interno opcional (ej. /que-hacemos#...).
  servicesJson  String @default("[]")

  casesTitle         String
  casesIntro         String
  /// IDs de Project, en el orden en que se muestran (máx. 4).
  caseProjectIdsJson String @default("[]")

  methodTitle     String
  methodIntro     String
  /// Una entrada por etapa del método (Analizamos, Planificamos...): { title, body }.
  methodStepsJson String @default("[]")

  partnerTitle      String
  partnerBody       String
  partnerPointsJson String @default("[]")

  testimonialsTitle         String
  /// IDs de Project cuya cita (quoteText/quoteAuthor) se muestra como testimonio.
  testimonialProjectIdsJson String @default("[]")

  faqTitle String
  /// { question, answer }
  faqsJson String @default("[]")

  ctaEyebrow String
  ctaTitle   String
  ctaBody    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
